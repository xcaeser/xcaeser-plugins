{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'For the whole session: any request that involves coding work (writing, changing, fixing or refactoring code) starts by invoking the x:work skill via the Skill tool, no exceptions. A request for a decision, which option is better, or how to approach something with more than one plausible design, when reading code or docs does not settle it, goes to the x:Fable-thinker agent with the question in the user'\\''s words, the files that matter and what you have learned; check its claims against the code, relay its answer in full with any claim that did not hold, and leave the choices it marks as the user'\\''s to the user.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/shared-checkout-guard.sh"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "if": "Edit(**/*.zig)", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/zig-deprecated.sh"] },
          { "type": "command", "if": "Edit(**/*.*ts*)", "command": "bun", "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/hooks/ts-deprecated.ts"], "timeout": 10 },
          { "type": "command", "if": "Edit(**/*.rs)", "command": "bun", "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/hooks/rust-deprecated.ts"], "timeout": 15 },
          { "type": "command", "if": "Edit(**/*.go)", "command": "bun", "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/hooks/go-deprecated.ts"], "timeout": 15 },
          { "type": "command", "if": "Write(**/*.zig)", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/zig-deprecated.sh"] },
          { "type": "command", "if": "Write(**/*.*ts*)", "command": "bun", "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/hooks/ts-deprecated.ts"], "timeout": 10 },
          { "type": "command", "if": "Write(**/*.rs)", "command": "bun", "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/hooks/rust-deprecated.ts"], "timeout": 15 },
          { "type": "command", "if": "Write(**/*.go)", "command": "bun", "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/hooks/go-deprecated.ts"], "timeout": 15 }
        ]
      }
    ]
  }
}
